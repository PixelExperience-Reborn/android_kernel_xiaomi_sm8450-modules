diff --git a/drivers/platform/msm/Kbuild b/drivers/platform/msm/Kbuild
index 7814f829..316fc064 100644
--- a/drivers/platform/msm/Kbuild
+++ b/drivers/platform/msm/Kbuild
@@ -1,4 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
+# External-module builds outside the Android tree pass DATAIPA_ROOT.
+DATAIPA_ROOT ?= $(srctree)/../../vendor/qcom/opensource/dataipa
 DATAIPADRVTOP = $(srctree)/techpack/dataipa/drivers/platform/msm
 
 #MSMs - GKI
@@ -17,12 +19,12 @@ endif
 
 #MSM - Vendor SI
 ifeq ($(CONFIG_ARCH_WAIPIO), y)
-DATAIPADRVTOP = $(srctree)/../../vendor/qcom/opensource/dataipa/drivers/platform/msm
-LINUXINCLUDE    += -include $(srctree)/../../vendor/qcom/opensource/dataipa/config/dataipa_vendor.h
-include $(srctree)/../../vendor/qcom/opensource/dataipa/config/dataipa_GKI.conf
+DATAIPADRVTOP = $(DATAIPA_ROOT)/drivers/platform/msm
+LINUXINCLUDE    += -include $(DATAIPA_ROOT)/config/dataipa_vendor.h
+include $(DATAIPA_ROOT)/config/dataipa_GKI.conf
 ifeq ($(CONFIG_LOCALVERSION), "-gki-consolidate")
-include $(srctree)/../../vendor/qcom/opensource/dataipa/config/dataipa_debug.conf
-LINUXINCLUDE    += -include $(srctree)/../../vendor/qcom/opensource/dataipa/config/dataipa_debug.h
+include $(DATAIPA_ROOT)/config/dataipa_debug.conf
+LINUXINCLUDE    += -include $(DATAIPA_ROOT)/config/dataipa_debug.h
 endif
 endif
 
