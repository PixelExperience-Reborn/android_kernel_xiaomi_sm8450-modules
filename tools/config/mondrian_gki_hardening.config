# Preserve official Google GKI security modes for Xiaomi mondrian on LLVM23.
# The original OEM c67ed74 CI ended in KASAN_GENERIC + LTO_NONE.
# Do not treat successful non-CFI/non-SCS object compilation as readiness.
CONFIG_KASAN=y
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_SW_TAGS is not set
CONFIG_KASAN_HW_TAGS=y
CONFIG_LTO_CLANG_FULL=y
# CONFIG_LTO_NONE is not set
CONFIG_CFI_CLANG=y
CONFIG_SHADOW_CALL_STACK=y
